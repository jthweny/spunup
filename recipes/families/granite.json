{
 "schema": 1,
 "id": "granite",
 "name": "Granite (IBM)",
 "hf_orgs": [
  "ibm-granite"
 ],
 "model_types": [
  "granite",
  "granitemoehybrid"
 ],
 "checked": "2026-11-06",
 "runtimes": {
  "vllm": {
   "supported": true,
   "tool_parser": "granite_toolcall_parser",
   "reasoning_parser": "granite_thinking_parser",
   "args": [],
   "chat_template": null,
   "env": {},
   "lora": {
    "args": [
     "--enable-lora",
     "--lora-modules",
     "{lora_name}={lora_path}",
     "--max-lora-rank",
     "{lora_rank}"
    ]
   },
   "caching": "Prefix caching is on by default."
  },
  "sglang": {
   "supported": true,
   "tool_parser": "auto",
   "reasoning_parser": "auto",
   "args": [],
   "lora": {
    "args": [
     "--enable-lora",
     "--lora-paths",
     "{lora_name}={lora_path}"
    ]
   },
   "caching": "Radix cache is on by default."
  },
  "llamacpp": {
   "supported": true,
   "args": [
    "--jinja",
    "--reasoning-format",
    "deepseek"
   ],
   "lora": {
    "args": [
     "--lora",
     "{lora_path}"
    ]
   },
   "caching": "--cache-prompt on by default; spunup adds --cache-reuse 256."
  },
  "mlx": {
   "supported": true,
   "args": [],
   "lora": {
    "args": [
     "--adapter-path",
     "{lora_path}"
    ]
   },
   "caching": "Prompt cache built in."
  }
 },
 "setups": {
  "gpu": {
   "best": "vllm",
   "others": [
    "sglang",
    "llamacpp"
   ],
   "command": "vllm serve {model} --host 127.0.0.1 --port {port} --api-key {api_key} --served-model-name {name} --max-model-len {ctx} --gpu-memory-utilization 0.90 --tensor-parallel-size {gpus} --enable-auto-tool-choice --tool-call-parser granite_toolcall_parser --reasoning-parser granite_thinking_parser"
  },
  "cpu": {
   "best": "llamacpp",
   "others": [],
   "command": "llama-server -m {gguf} --host 127.0.0.1 --port {port} --api-key {api_key} --alias {name} -c {ctx} --jinja --reasoning-format deepseek --cache-reuse 256 -np 1 --fit on {gpu_layers}"
  },
  "mixed": {
   "best": "llamacpp",
   "others": [],
   "command": "llama-server -m {gguf} --host 127.0.0.1 --port {port} --api-key {api_key} --alias {name} -c {ctx} --jinja --reasoning-format deepseek --cache-reuse 256 -np 1 --fit on {gpu_layers} {cpu_moe}"
  },
  "mac": {
   "best": "llamacpp",
   "others": [
    "mlx"
   ],
   "command": "llama-server -m {gguf} --host 127.0.0.1 --port {port} --api-key {api_key} --alias {name} -c {ctx} --jinja --reasoning-format deepseek --cache-reuse 256 -np 1 --fit on {gpu_layers}"
  }
 },
 "notes": [
  "The Granite 4.2 model card uses --tool-call-parser qwen3_coder with a plugin reasoning parser; vLLM's docs list built-in granite_toolcall_parser / granite_thinking_parser. spunup uses the built-in ones."
 ],
 "members": [
  "ibm-granite/granite-4.1-3b",
  "ibm-granite/granite-4.2-30b",
  "ibm-granite/granite-4.2-8b"
 ],
 "sources": [
  "https://github.com/vllm-project/vllm/blob/main/docs/features/tool_calling.md#ibm-granite",
  "https://github.com/vllm-project/vllm/blob/main/docs/features/reasoning_outputs.md",
  "https://huggingface.co/ibm-granite/granite-4.2-8b",
  "https://github.com/sgl-project/sglang/tree/main/docs/src/snippets/configs/ibm-granite/granite-4.2.jsx"
 ],
 "gguf_publishers": [
  "ggml-org",
  "unsloth",
  "bartowski",
  "lmstudio-community",
  "ibm-granite"
 ],
 "mlx_publishers": [
  "mlx-community",
  "lmstudio-community",
  "ibm-granite"
 ]
}