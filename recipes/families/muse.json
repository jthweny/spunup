  "https://github.com/vllm-project/vllm/blob/main/docs/features/tool_calling.md#muse-models-muse"
 ],
 "gguf_publishers": [
  "ggml-org",
  "unsloth",
  "bartowski",
  "lmstudio-community",
  "meta-models"
 ],
 "mlx_publishers": [
