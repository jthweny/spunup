{
 "schema": 1,
 "id": "nemotron",
 "name": "Nemotron (NVIDIA)",
 "hf_orgs": [
  "nvidia"
 ],
 "model_types": [
  "nemotron_h"
 ],
 "checked": "2026-11-06",
 "runtimes": {
  "vllm": {
   "supported": true,
   "tool_parser": "qwen3_coder",
   "reasoning_parser": "nemotron_v3",
   "args": [
    "--trust-remote-code"
   ],
   "chat_template": null,
   "env": {},
   "lora": {
    "args": [
     "--enable-lora",
     "--lora-modules",
     "{lora_name}={lora_path}",
     "--max-lora-rank",
     "{lora_rank}"
    ]
   },
   "caching": "Prefix caching is on by default."
  },
  "sglang": {
   "supported": true,
   "tool_parser": "qwen3_coder",
   "reasoning_parser": "nemotron_3",
   "args": [
    "--trust-remote-code"
   ],
   "lora": {
    "args": [
     "--enable-lora",
     "--lora-paths",
     "{lora_name}={lora_path}"
    ]
   },
   "caching": "Radix cache is on by default."
  },
  "llamacpp": {
   "supported": true,
   "args": [
    "--jinja",
    "--reasoning-format",
    "deepseek"
   ],
   "lora": {
    "args": [
     "--lora",
     "{lora_path}"
    ]
   },
   "caching": "--cache-prompt on by default; spunup adds --cache-reuse 256."
  },
  "mlx": {
   "supported": true,
   "args": [],
   "lora": {
    "args": [
     "--adapter-path",
     "{lora_path}"
    ]
   },
   "caching": "Prompt cache built in."
  }
 },
 "setups": {
  "gpu": {
   "best": "vllm",
   "others": [
    "sglang",
    "llamacpp"
   ],
   "command": "vllm serve {model} --host 127.0.0.1 --port {port} --api-key {api_key} --served-model-name {name} --max-model-len {ctx} --gpu-memory-utilization 0.90 --tensor-parallel-size {gpus} --trust-remote-code --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser nemotron_v3"
  },
  "cpu": {
   "best": "llamacpp",
   "others": [],
   "command": "llama-server -m {gguf} --host 127.0.0.1 --port {port} --api-key {api_key} --alias {name} -c {ctx} --jinja --reasoning-format deepseek --cache-reuse 256 -np 1 --fit on {gpu_layers}"
  },
  "mixed": {
   "best": "llamacpp",
   "others": [],
   "command": "llama-server -m {gguf} --host 127.0.0.1 --port {port} --api-key {api_key} --alias {name} -c {ctx} --jinja --reasoning-format deepseek --cache-reuse 256 -np 1 --fit on {gpu_layers} {cpu_moe}"
  },
  "mac": {
   "best": "llamacpp",
   "others": [
    "mlx"
   ],
   "command": "llama-server -m {gguf} --host 127.0.0.1 --port {port} --api-key {api_key} --alias {name} -c {ctx} --jinja --reasoning-format deepseek --cache-reuse 256 -np 1 --fit on {gpu_layers}"
  }
 },
 "notes": [
  "NVIDIA's org also hosts quantized copies of other families; those keep their own family."
 ],
 "members": [
  "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16",
  "nvidia/NVIDIA-Nemotron-3-Nano-4B-BF16",
  "nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-BF16",
  "nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B-BF16",
  "nvidia/NVIDIA-Nemotron-3.5-Bolt-E4B-BF16",
  "nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16"
 ],
 "sources": [
  "https://github.com/vllm-project/recipes/tree/main/models/nvidia",
  "https://github.com/sgl-project/sglang/tree/main/docs/src/snippets/configs/nvidia/nemotron-3.5-lightning.jsx"
 ],
 "gguf_publishers": [
  "ggml-org",
  "unsloth",
  "bartowski",
  "lmstudio-community",
  "nvidia"
 ],
 "mlx_publishers": [
  "mlx-community",
  "lmstudio-community",
  "nvidia"
 ]
}