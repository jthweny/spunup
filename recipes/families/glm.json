{
 "schema": 1,
 "id": "glm",
 "name": "GLM (Z.ai)",
 "hf_orgs": [
  "zai-org"
 ],
 "model_types": [
  "glm_moe_dsa",
  "glm5_next",
  "glm4_moe",
  "glm4_moe_lite"
 ],
 "checked": "2026-11-06",
 "runtimes": {
  "vllm": {
   "supported": true,
   "tool_parser": "glm47",
   "reasoning_parser": "glm47",
   "args": [],
   "chat_template": null,
   "env": {},
   "lora": {
    "args": [
     "--enable-lora",
     "--lora-modules",
     "{lora_name}={lora_path}",
     "--max-lora-rank",
     "{lora_rank}"
    ]
   },
   "caching": "Prefix caching is on by default."
  },
  "sglang": {
   "supported": true,
   "tool_parser": "glm47",
   "reasoning_parser": "glm45",
   "args": [],
   "lora": {
    "args": [
     "--enable-lora",
     "--lora-paths",
     "{lora_name}={lora_path}"
    ]
   },
   "caching": "Radix cache is on by default."
  },
  "llamacpp": {
   "supported": true,
   "args": [
    "--jinja",
    "--reasoning-format",
    "deepseek"
   ],
   "lora": {
    "args": [
     "--lora",
     "{lora_path}"
    ]
   },
   "caching": "--cache-prompt on by default; spunup adds --cache-reuse 256."
  },
  "mlx": {
   "supported": true,
   "args": [],
   "lora": {
    "args": [
     "--adapter-path",
     "{lora_path}"
    ]
   },
   "caching": "Prompt cache built in."
  }
 },
 "setups": {
  "gpu": {
   "best": "vllm",
   "others": [
    "sglang",
    "llamacpp"
   ],
   "command": "vllm serve {model} --host 127.0.0.1 --port {port} --api-key {api_key} --served-model-name {name} --max-model-len {ctx} --gpu-memory-utilization 0.90 --tensor-parallel-size {gpus} --enable-auto-tool-choice --tool-call-parser glm47 --reasoning-parser glm47"
  },
  "cpu": {
   "best": "llamacpp",
   "others": [],
   "command": "llama-server -m {gguf} --host 127.0.0.1 --port {port} --api-key {api_key} --alias {name} -c {ctx} --jinja --reasoning-format deepseek --cache-reuse 256 -np 1 --fit on {gpu_layers}"
  },
  "mixed": {
   "best": "llamacpp",
   "others": [],
   "command": "llama-server -m {gguf} --host 127.0.0.1 --port {port} --api-key {api_key} --alias {name} -c {ctx} --jinja --reasoning-format deepseek --cache-reuse 256 -np 1 --fit on {gpu_layers} {cpu_moe}"
  },
  "mac": {
   "best": "llamacpp",
   "others": [
    "mlx"
   ],
   "command": "llama-server -m {gguf} --host 127.0.0.1 --port {port} --api-key {api_key} --alias {name} -c {ctx} --jinja --reasoning-format deepseek --cache-reuse 256 -np 1 --fit on {gpu_layers}"
  }
 },
 "notes": [
  "For chat, pass chat_template_kwargs {\"clear_thinking\": true}; agents should keep the default."
 ],
 "members": [
  "zai-org/GLM-4.5-Air",
  "zai-org/GLM-4.7-Flash",
  "zai-org/GLM-5.1",
  "zai-org/GLM-5.2",
  "zai-org/GLM-5.3",
  "zai-org/GLM-5.3-Flash"
 ],
 "sources": [
  "https://github.com/vllm-project/recipes/tree/main/models/zai-org",
  "https://github.com/sgl-project/sglang/tree/main/docs/src/snippets/configs/zai-org/glm-5.2.jsx",
  "https://huggingface.co/zai-org/GLM-5.3"
 ],
 "gguf_publishers": [
  "ggml-org",
  "unsloth",
  "bartowski",
  "lmstudio-community",
  "zai-org"
 ],
 "mlx_publishers": [
  "mlx-community",
  "lmstudio-community",
  "zai-org"
 ]
}