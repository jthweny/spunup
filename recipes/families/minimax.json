{
 "schema": 1,
 "id": "minimax",
 "name": "MiniMax",
 "hf_orgs": [
  "MiniMaxAI"
 ],
 "model_types": [
  "minimax_m2",
  "minimax_m3_vl",
  "minimax_m3"
 ],
 "checked": "2026-11-06",
 "runtimes": {
  "vllm": {
   "supported": true,
   "tool_parser": "minimax_m3",
   "reasoning_parser": "minimax_m3",
   "args": [
    "--block-size",
    "128"
   ],
   "chat_template": null,
   "env": {},
   "lora": {
    "args": [
     "--enable-lora",
     "--lora-modules",
     "{lora_name}={lora_path}",
     "--max-lora-rank",
     "{lora_rank}"
    ]
   },
   "caching": "Prefix caching is on by default."
  },
  "sglang": {
   "supported": true,
   "tool_parser": "minimax-m3",
   "reasoning_parser": "minimax-m3",
   "args": [],
   "lora": {
    "args": [
     "--enable-lora",
     "--lora-paths",
     "{lora_name}={lora_path}"
    ]
   },
   "caching": "Radix cache is on by default."
  },
  "llamacpp": {
   "supported": true,
   "args": [
    "--jinja",
    "--reasoning-format",
    "deepseek"
   ],
   "lora": {
    "args": [
     "--lora",
     "{lora_path}"
    ]
   },
   "caching": "--cache-prompt on by default; spunup adds --cache-reuse 256."
  },
  "mlx": {
   "supported": true,
   "args": [],
   "lora": {
    "args": [
     "--adapter-path",
     "{lora_path}"
    ]
   },
   "caching": "Prompt cache built in."
  }
 },
 "setups": {
  "gpu": {
   "best": "vllm",
   "others": [
    "sglang",
    "llamacpp"
   ],
   "command": "vllm serve {model} --host 127.0.0.1 --port {port} --api-key {api_key} --served-model-name {name} --max-model-len {ctx} --gpu-memory-utilization 0.90 --tensor-parallel-size {gpus} --block-size 128 --enable-auto-tool-choice --tool-call-parser minimax_m3 --reasoning-parser minimax_m3"
  },
  "cpu": {
   "best": "llamacpp",
   "others": [],
   "command": "llama-server -m {gguf} --host 127.0.0.1 --port {port} --api-key {api_key} --alias {name} -c {ctx} --jinja --reasoning-format deepseek --cache-reuse 256 -np 1 --fit on {gpu_layers}"
  },
  "mixed": {
   "best": "llamacpp",
   "others": [],
   "command": "llama-server -m {gguf} --host 127.0.0.1 --port {port} --api-key {api_key} --alias {name} -c {ctx} --jinja --reasoning-format deepseek --cache-reuse 256 -np 1 --fit on {gpu_layers} {cpu_moe}"
  },
  "mac": {
   "best": "llamacpp",
   "others": [
    "mlx"
   ],
   "command": "llama-server -m {gguf} --host 127.0.0.1 --port {port} --api-key {api_key} --alias {name} -c {ctx} --jinja --reasoning-format deepseek --cache-reuse 256 -np 1 --fit on {gpu_layers}"
  }
 },
 "notes": [
  "MiniMax M2.x use the minimax_m2 parsers instead."
 ],
 "members": [
  "MiniMaxAI/MiniMax-M2.5",
  "MiniMaxAI/MiniMax-M2.7",
  "MiniMaxAI/MiniMax-M3",
  "MiniMaxAI/MiniMax-M3.1-Flash"
 ],
 "sources": [
  "https://github.com/vllm-project/recipes/tree/main/models/MiniMaxAI",
  "https://github.com/sgl-project/sglang/tree/main/docs/src/snippets/configs/MiniMaxAI/minimax-m3.1.jsx"
 ],
 "gguf_publishers": [
  "ggml-org",
  "unsloth",
  "bartowski",
  "lmstudio-community",
  "MiniMaxAI"
 ],
 "mlx_publishers": [
  "mlx-community",
  "lmstudio-community",
  "MiniMaxAI"
 ]
}